# แอปแจ้งเตือนไข้เลือดออก SRRT — ตัวอย่างไฟล์ตั้งค่า
#
# คัดลอกเป็น .env บนเซิร์ฟเวอร์ แล้วใส่ SECRET_KEY (จำเป็นเสมอ) — ค่า <...> ตัวอื่นแทนด้วยค่าของ รพ. ตัวเอง
# หรือถ้าจะตั้งจากหน้า /settings (ดูด้านล่าง) ให้ลบบรรทัด <...> เหล่านั้นทิ้ง
#   Linux: chmod 640 .env และ chown root:dengue .env   (ห้าม commit ไฟล์ .env เข้า git)
# กุญแจ MOPH, รหัสผ่านฐานข้อมูล และ SECRET_KEY ให้ผู้ที่เป็นเจ้าของค่านั้นพิมพ์เอง — SECRET_KEY พิมพ์ลง .env บนเซิร์ฟเวอร์,
# รหัสผ่านฐานข้อมูลและกุญแจ MOPH พิมพ์ลง .env หรือที่หน้า /settings ก็ได้
# ห้ามส่งค่าเหล่านี้ทางแชทหรืออีเมล
#
# รูปแบบไฟล์ (อ่านโดย systemd EnvironmentFile ตอนรันเป็น service และโดย envfile.py ตอนรัน python run.py / setup_check.py มือ):
#   - หนึ่งบรรทัดต่อหนึ่งค่า NAME=value ห้ามขยายตัวแปร ($VAR) ห้ามมีคำสั่ง
#   - ห้ามเขียนคอมเมนต์ต่อท้ายบรรทัดค่า (# กลางบรรทัดเป็นส่วนของค่า) ให้เขียนบรรทัดคอมเมนต์แยก
#   - ค่าที่มีช่องว่างหรืออักขระพิเศษ ($ # ! & ; ฯลฯ) ให้ครอบด้วย single quote เช่น DB_PASS='abc#123'
#     (ค่าที่มี single quote อยู่ในตัวไม่รองรับ)
#   - บรรทัดที่ขึ้นต้นด้วย # คือค่าเริ่มต้นของแอป เอา # ออกเฉพาะเมื่อต้องการเปลี่ยน
#   - ค่า <...> ที่ไม่ได้แทนจะถูกปฏิเสธ: SECRET_KEY ที่เป็น <...> หรือสั้นกว่า 16 ตัวอักษร = แอปไม่เริ่ม,
#     MOPH_* ที่เป็น <...> = ถือว่ายังไม่ได้ตั้ง (ไม่ส่ง LINE)
#   - ตรวจก่อนรัน: grep -nE '^[A-Z_]+=<' .env   (ต้องไม่พิมพ์อะไรออกมา)
#
# หน้าตั้งค่า /settings (v1.1.0, เฉพาะบัญชี admin จากเครือข่ายภายใน — ดู INSTALL.md ข้อ 4.9 และข้อ 11):
#   ตัวแปร 11 ตัวด้านล่างตั้งจากหน้าเว็บได้ ค่าที่ตั้งจากหน้าเว็บอยู่ใน data/settings.json
#   และ ค่าที่ตั้งจากหน้าเว็บชนะค่าใน .env (ลำดับ: .env -> data/settings.json ชนะ -> ค่าเริ่มต้นของแอป)
#     DB_HOST DB_PORT DB_NAME DB_USER DB_PASS
#     MOPH_CLIENT_KEY MOPH_SECRET_KEY
#     DENGUE_START_FROM DENGUE_BASE_URL DENGUE_DATA_AUDITED DENGUE_DISEASES
#   ตัวแปรที่เหลือทั้งหมด รวมถึง SECRET_KEY ตั้งได้เฉพาะใน .env (หน้าเว็บแก้ไม่ได้)
#   DB_PASS และกุญแจ MOPH ที่ตั้งจากหน้าเว็บ ไม่ถูกเขียนลง .env (เก็บใน data/settings.json เป็นข้อความธรรมดา สิทธิ์ 600)
#   ถ้าแก้ตัวแปร 11 ตัวนี้ใน .env แล้วไม่เห็นผล ให้ดูที่หน้า /check ว่าค่านั้นมาจาก "หน้าตั้งค่า" หรือไม่
#   ติดตั้งใหม่ใส่ใน .env แค่ SECRET_KEY แล้วตั้งที่เหลือจากหน้าเว็บก็ได้ — บรรทัดตัวอย่างด้านล่างใช้เมื่อตั้งในไฟล์ (หรือ deploy/set_env.py)

# ============================================================
# ส่วนที่ต้องตั้ง (ไม่ตั้ง = แอปไม่เริ่ม หรือไม่ส่งแจ้งเตือน)
# ============================================================

# กุญแจเซ็นคุกกี้ล็อกอิน (สุ่มยาวอย่างน้อย 32 ตัวอักษร) — ว่าง สั้นกว่า 16 ตัวอักษร หรือยังเป็น <...> = แอปไม่เริ่ม
# สร้างด้วย: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<สุ่มยาว 32 ตัวอักษรขึ้นไป>

# วันที่เริ่มใช้งานจริง รูปแบบ YYYY-MM-DD — แจ้งเฉพาะการวินิจฉัยตั้งแต่วันนี้เป็นต้นไป
# ตั้งเป็นวัน go-live (กันแจ้งข้อมูลย้อนหลังท่วมกลุ่ม และกันเคสสะสมถูกส่งรวดเดียวเมื่อใส่กุญแจ MOPH ช้า)
# ไม่ตั้ง = ใช้วันที่แอปเริ่มทำงาน (ค่าจะเลื่อนไปทุกครั้งที่ restart ซึ่งเสี่ยงตกหล่น จึงควรตั้งเสมอ)
DENGUE_START_FROM=<YYYY-MM-DD>

# ---- ฐานข้อมูล HOSxP (ใช้บัญชี SELECT-only เท่านั้น ห้ามใช้บัญชีที่แก้ตารางได้) ----
# ที่อยู่เซิร์ฟเวอร์ฐานข้อมูล HOSxP (ไม่ตั้ง = แอปต่อฐานไม่ได้)
DB_HOST=<ที่อยู่ฐานข้อมูล>
# พอร์ต (ค่าเริ่มต้น 3306)
# DB_PORT=3306
# ชื่อฐาน HOSxP (ค่าเริ่มต้น hos)
# DB_NAME=hos
# ชื่อบัญชี SELECT-only
DB_USER=<readonly_user>
# รหัสผ่านของบัญชีนั้น
DB_PASS=<รหัสผ่านฐานข้อมูล>

# ---- MOPH Notify (หมอพร้อม) กลุ่ม SRRT ----
# ปลายทาง MOPH Notify (ค่าเริ่มต้น https://morpromt2f.moph.go.th)
# MOPH_BASE_URL=https://morpromt2f.moph.go.th
# Client ID ของกลุ่ม (ดูได้ใน CMS MOPH Notify) — ไม่ตั้ง = ตรวจจับเคสได้แต่ไม่ส่ง LINE
MOPH_CLIENT_KEY=<Client ID ของกลุ่ม>
# Secret ของกลุ่ม (ดูได้ใน CMS MOPH Notify)
MOPH_SECRET_KEY=<Secret ของกลุ่ม>

# ลิงก์ฐานที่ใส่ในข้อความ LINE (ค่าเริ่มต้น https://wnkhos.go.th/dengue) — รพ.อื่นต้องเปลี่ยน
DENGUE_BASE_URL=<https://โดเมนของ รพ./dengue>

# ============================================================
# ส่วนปรับแต่ง (ค่าเริ่มต้นใช้ได้เลย เอา # ออกเมื่ออยากเปลี่ยน)
# ============================================================

# ขึ้นต้นรหัสโรคที่แจ้ง คั่นด้วยจุลภาค (ค่าเริ่มต้น A90,A91) — ตรวจกับข้อมูล รพ. ที่หน้า /check
# DENGUE_ICDS=A90,A91

# ความถี่ตรวจ HOSxP เป็นวินาที (ค่าเริ่มต้น 120)
# DENGUE_POLL_SECONDS=120

# เกณฑ์ cluster: จำนวนรายขั้นต่ำของกลุ่ม (ค่าเริ่มต้น 2)
# DENGUE_CLUSTER_MIN_CASES=2

# โรคที่ติดตาม (key คั่นด้วยจุลภาค: dengue, lepto, malaria, chik, hfmd, varicella, diarrhea) ค่าเริ่มต้น dengue
# (เปิด/ปิดได้ที่หน้า /settings) · เกณฑ์ของโรคอื่นตั้งด้วย DENGUE_<KEY>_ICDS / _MIN_CASES / _DAYS / _RADIUS_M
# เช่น KEY=HFMD · ของไข้เลือดออกใช้ชื่อเดิมด้านล่าง
# DENGUE_DISEASES=dengue

# เกณฑ์ cluster: รัศมีระหว่างหมุดเป็นเมตร (ค่าเริ่มต้น 100)
# DENGUE_CLUSTER_RADIUS_M=100

# เกณฑ์ cluster: วันวินิจฉัยห่างกันไม่เกินกี่วัน (ค่าเริ่มต้น 14)
# DENGUE_CLUSTER_DAYS=14

# ผู้ป่วย HN เดิมที่มาตามอาการภายในกี่วันหลังเคสก่อนหน้า จะไม่นับเป็นเคสใหม่และไม่แจ้งซ้ำ (ค่าเริ่มต้น 21)
# DENGUE_REALERT_DAYS=21

# ตรวจว่ารหัสโรคของเคสหายไปหรือไม่ (ยกเลิกเคสเมื่อหายติดกัน 3 รอบ) เฉพาะเคสที่วินิจฉัยภายในกี่วันล่าสุด
# เคสเก่ากว่านี้ไม่ถูกตรวจซ้ำ (ค่าเริ่มต้น 90) — ถ้ารหัสกลับมาภายหลัง เคสที่ยกเลิกไปจะคืนสถานะเองอัตโนมัติ
# DENGUE_CANCEL_CHECK_DAYS=90

# รหัสจังหวัด+อำเภอ 4 หลักที่ถือว่า "ในเขต" คั่นด้วยจุลภาคได้หลายอำเภอ
# ไม่ตั้ง = ใช้อำเภอของหมู่บ้านในตาราง village (ตรวจที่หน้า /check ว่าถูกต้อง)
# DENGUE_AREA_AMPHOE=<รหัสจังหวัด+อำเภอ 4 หลัก>

# แหล่ง tile แผนที่ (ค่าเริ่มต้น OpenStreetMap) — ตั้งเป็น tile server ของ รพ.เองถ้าไม่อยากให้เบราว์เซอร์ขอแผนที่จากภายนอก
# DENGUE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ตั้งเป็น 1 หลังตรวจตัวเลขกับข้อมูล รพ. นี้และทดลองคู่กับแจ้งเตือน 506 เดิมแล้ว (ซ่อนแถบเตือน) — ดู INSTALL.md ข้อ 0
# DENGUE_DATA_AUDITED=0

# ที่เก็บฐาน SQLite ของแอป เป็น path สัมพัทธ์กับโฟลเดอร์แอป (ค่าเริ่มต้น data/dengue.db)
# โฟลเดอร์นี้ต้องเขียนได้เฉพาะผู้ใช้ dengue และไฟล์ scheduler.lock จะอยู่ข้างไฟล์นี้
# ถ้าเปลี่ยนค่านี้ไปนอกโฟลเดอร์ data/ ต้องแก้ ReadWritePaths ในไฟล์ unit ของ systemd (deploy/wnk-dengue.service) ให้ตรงด้วย
# DENGUE_DB_PATH=data/dengue.db

# prefix ที่อยู่ IP ของเครือข่ายภายในที่เปิดหน้า /check ได้ คั่นด้วยจุลภาค (ลงท้าย . หรือไม่ก็ได้)
# ค่าเริ่มต้น = ช่วง private ทั่วไป (10. 172.16-31. 192.168. 127.) และ 30.25. ของ รพ.วังน้ำเขียว
# รพ.อื่นควรตั้งให้ตรงกับเครือข่ายตัวเอง
# DENGUE_LAN_PREFIXES=<prefix1,prefix2>

# เปิด/ปิดตัวตั้งเวลาตรวจจับในโปรเซสเว็บ (ค่าเริ่มต้น 1) — ตั้ง 0 เฉพาะตอนต้องการรันเว็บโดยไม่ตรวจจับ
# DENGUE_SCHEDULER=1

# ไฟล์ .env ที่ python run.py / python setup_check.py จะโหลด (ค่าเริ่มต้น ./.env ในโฟลเดอร์ที่รันคำสั่ง)
# ใช้เฉพาะคำสั่งบรรทัดคำสั่ง — service โหลดจาก EnvironmentFile ใน unit; ตัวแปรที่ตั้งไว้แล้วใน environment จะไม่ถูกทับ
# DENGUE_ENV_FILE=/opt/dengue_srrt/.env
